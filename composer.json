{
    "name": "mazer-dev/nativephp-dialogify",
    "description": "A native communication hub for NativePHP Mobile — toasts, alerts, and bottom sheets crafted in Kotlin and Swift",
    "type": "nativephp-plugin",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "nativephp/mobile": "^3.0"
    },
    "require-dev": {
        "laravel/pint": "^1.27",
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "MazerDev\\Dialogify\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MazerDev\\Dialogify\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "MazerDev\\Dialogify\\Providers\\DialogifyServiceProvider"
            ]
        },
        "nativephp": {
            "manifest": "nativephp.json"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
